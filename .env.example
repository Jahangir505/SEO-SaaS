# Docker Compose configuration (read automatically by `docker compose` from ./.env).
# App-level variables live in apps/api/.env.example and apps/web/.env.example.

# ─── PostgreSQL ─────────────────────────────────────────
POSTGRES_USER=seoflow
POSTGRES_PASSWORD=seoflow
POSTGRES_DB=seoflow

# ─── Host ports (bound to 127.0.0.1) ────────────────────
# Non-default Postgres/Redis ports avoid clashing with other local stacks.
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6381
API_HOST_PORT=4000
WEB_HOST_PORT=3000

# ─── App ────────────────────────────────────────────────
API_LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000
# Browser-facing API URL, baked into the web image at build time.
NEXT_PUBLIC_API_URL=http://localhost:4000
